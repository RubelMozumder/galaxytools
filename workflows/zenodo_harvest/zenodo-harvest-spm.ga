{
    "name": "Zenodo harvest for SPM data",
    "a_galaxy_workflow": "true",
    "format-version": "0.1",
    "annotation": "Downloads the files of a work list from Zenodo, reads each raw SPM file's header, finds its\ntechnique, builds its ELN (optionally with an LLM through LLM Hub), converts the raw files to\nNeXus with pynxtools-spm and builds the results, NOMAD project zips and logs for the\nzenodo_harvest Action of nomad-eosc-galaxy-actions.\n",
    "tags": [],
    "license": "MIT",
    "uuid": "82f13f72-e3c1-4b2b-9cfe-0d87e49e2d27",
    "creator": [
        {
            "name": "Rubel Mozumder",
            "url": "https://github.com/RubelMozumder",
            "class": "Person"
        },
        {
            "name": "FAIRmat",
            "url": "https://www.fairmat-nfdi.eu/fairmat/",
            "class": "Organization"
        }
    ],
    "comments": [],
    "steps": {
        "0": {
            "id": 0,
            "name": "work list",
            "type": "data_input",
            "label": "work list",
            "annotation": "work_list.json from the NOMAD side.",
            "tool_state": "{\"name\": \"work list\", \"format\": [\"json\"]}",
            "position": {
                "top": 0,
                "left": 0
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "work list",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {}
        },
        "1": {
            "id": 1,
            "name": "prefetched files",
            "type": "data_collection_input",
            "label": "prefetched files",
            "annotation": "Optional. Files already in Galaxy, with the Zenodo file key as element identifier.",
            "tool_state": "{\"name\": \"prefetched files\", \"optional\": true, \"collection_type\": \"list\"}",
            "position": {
                "top": 10,
                "left": 10
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "prefetched files",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {}
        },
        "2": {
            "id": 2,
            "name": "use llm",
            "type": "parameter_input",
            "label": "use llm",
            "annotation": "Let an LLM (LLM Hub) find the technique and fill the ELN fields the rules leave empty. On by default; needs \"llm model\".",
            "tool_state": "{\"name\": \"use llm\", \"parameter_type\": \"boolean\", \"default\": true}",
            "position": {
                "top": 20,
                "left": 20
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "use llm",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {}
        },
        "3": {
            "id": 3,
            "name": "llm model",
            "type": "parameter_input",
            "label": "llm model",
            "annotation": "LLM Hub multimodal model: a value of the server's genai_models table with type \"multimodal\". The default is a model on usegalaxy.eu.",
            "tool_state": "{\"name\": \"llm model\", \"parameter_type\": \"text\", \"default\": \"mistral-medium-3.5-e-infra.cz\"}",
            "position": {
                "top": 30,
                "left": 30
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "llm model",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {}
        },
        "4": {
            "id": 4,
            "name": "eln rules",
            "type": "data_input",
            "label": "eln rules",
            "annotation": "Optional. ELN rules to use instead of pynxtools-spm's eln_rules.yaml, e.g. a fix to test.",
            "tool_state": "{\"name\": \"eln rules\", \"optional\": true, \"format\": [\"yaml\"]}",
            "position": {
                "top": 40,
                "left": 40
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "eln rules",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {}
        },
        "5": {
            "id": 5,
            "name": "eln instructions",
            "type": "data_input",
            "label": "eln instructions",
            "annotation": "Optional. ELN instructions to use instead of pynxtools-spm's eln_instructions.md.",
            "tool_state": "{\"name\": \"eln instructions\", \"optional\": true, \"format\": [\"txt\"]}",
            "position": {
                "top": 50,
                "left": 50
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "eln instructions",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {}
        },
        "6": {
            "id": 6,
            "name": "zenodo_nomad_download",
            "type": "tool",
            "label": "download",
            "annotation": "Download and safely unzip the work list's files; write the manifest.",
            "tool_state": "{\"__page__\": 0, \"pipeline_version\": \"pynxtools_spm_converter 0.5.1+galaxy0\"}",
            "tool_id": "zenodo_nomad_download",
            "tool_version": "0.2.0",
            "position": {
                "top": 60,
                "left": 60
            },
            "input_connections": {
                "work_list": [
                    {
                        "id": 0,
                        "output_name": "output"
                    }
                ],
                "prefetched": [
                    {
                        "id": 1,
                        "output_name": "output"
                    }
                ]
            },
            "inputs": [],
            "outputs": [],
            "workflow_outputs": [
                {
                    "label": "manifest",
                    "output_name": "manifest"
                }
            ],
            "post_job_actions": {}
        },
        "7": {
            "id": 7,
            "name": "pynxtools_spm_eln_files",
            "type": "tool",
            "label": "eln_files",
            "annotation": "The ELN rules and instructions of pynxtools-spm, or the given overrides; once per run.",
            "tool_state": "{\"__page__\": 0}",
            "tool_id": "pynxtools_spm_eln_files",
            "tool_version": "0.5.1+galaxy0",
            "position": {
                "top": 70,
                "left": 70
            },
            "input_connections": {
                "rules_override": [
                    {
                        "id": 4,
                        "output_name": "output"
                    }
                ],
                "instructions_override": [
                    {
                        "id": 5,
                        "output_name": "output"
                    }
                ]
            },
            "inputs": [],
            "outputs": [],
            "workflow_outputs": [
                {
                    "label": "eln rules used",
                    "output_name": "rules"
                },
                {
                    "label": "eln instructions used",
                    "output_name": "instructions"
                }
            ],
            "post_job_actions": {}
        },
        "8": {
            "id": 8,
            "name": "spm_raw_header",
            "type": "tool",
            "label": "header",
            "annotation": "Read each raw file's header (metadata) as JSON with gwyddionpy.",
            "tool_state": "{\"__page__\": 0}",
            "tool_id": "spm_raw_header",
            "tool_version": "0.5.1+galaxy0",
            "position": {
                "top": 80,
                "left": 80
            },
            "input_connections": {
                "raw": [
                    {
                        "id": 6,
                        "output_name": "raw_files"
                    }
                ]
            },
            "inputs": [],
            "outputs": [],
            "workflow_outputs": [
                {
                    "label": "headers",
                    "output_name": "header"
                }
            ],
            "post_job_actions": {}
        },
        "9": {
            "id": 9,
            "name": "nexus_llm_input",
            "type": "tool",
            "label": "detect_input",
            "annotation": "Write the input of the detection job per raw file (Detection instructions, header, record and context texts).",
            "tool_state": "{\"__page__\": 0, \"stage_cond\": {\"stage\": \"detect\"}}",
            "tool_id": "nexus_llm_input",
            "tool_version": "0.4.0",
            "position": {
                "top": 90,
                "left": 90
            },
            "input_connections": {
                "bundle": [
                    {
                        "id": 6,
                        "output_name": "context_bundles"
                    }
                ],
                "header": [
                    {
                        "id": 8,
                        "output_name": "header"
                    }
                ],
                "rules": [
                    {
                        "id": 7,
                        "output_name": "rules"
                    }
                ],
                "instructions": [
                    {
                        "id": 7,
                        "output_name": "instructions"
                    }
                ]
            },
            "inputs": [],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {}
        },
        "10": {
            "id": 10,
            "name": "llm_hub",
            "type": "tool",
            "label": "detect",
            "annotation": "Ask the LLM for each raw file's technique and scan mode, with quotes. Skipped unless \"use llm\".",
            "when": "$(inputs.should_run)",
            "tool_state": "{\"__page__\": 0, \"model_condition\": {\"model_type\": \"multimodal\", \"image_context\": null, \"prompt\": \"Follow the instructions in the file eln_instructions.txt exactly. Use only the other context files as sources. Answer with the two YAML blocks only.\"}, \"advanced\": {\"temperature\": 0.0}}",
            "tool_id": "llm_hub",
            "tool_version": "2.53.0+galaxy0",
            "position": {
                "top": 100,
                "left": 100
            },
            "input_connections": {
                "model_condition|text_context": [
                    {
                        "id": 9,
                        "output_name": "llm_context"
                    }
                ],
                "model_condition|model": [
                    {
                        "id": 3,
                        "output_name": "output"
                    }
                ],
                "should_run": [
                    {
                        "id": 2,
                        "output_name": "output"
                    }
                ]
            },
            "inputs": [],
            "outputs": [],
            "workflow_outputs": [
                {
                    "label": "detection answers",
                    "output_name": "output"
                }
            ],
            "post_job_actions": {}
        },
        "11": {
            "id": 11,
            "name": "nexus_eln_builder",
            "type": "tool",
            "label": "eln",
            "annotation": "Build an ELN per raw file. The technique comes from the detection answer if its quote is found, else from the header markers of the rules, else from the file extension.",
            "tool_state": "{\"__page__\": 0, \"technique\": \"auto\"}",
            "tool_id": "nexus_eln_builder",
            "tool_version": "0.4.0",
            "position": {
                "top": 110,
                "left": 110
            },
            "input_connections": {
                "bundle": [
                    {
                        "id": 6,
                        "output_name": "context_bundles"
                    }
                ],
                "header": [
                    {
                        "id": 8,
                        "output_name": "header"
                    }
                ],
                "rules": [
                    {
                        "id": 7,
                        "output_name": "rules"
                    }
                ],
                "answer": [
                    {
                        "id": 10,
                        "output_name": "output"
                    }
                ]
            },
            "inputs": [],
            "outputs": [],
            "workflow_outputs": [
                {
                    "label": "eln reports",
                    "output_name": "eln_report"
                }
            ],
            "post_job_actions": {}
        },
        "12": {
            "id": 12,
            "name": "nexus_llm_input",
            "type": "tool",
            "label": "llm_input",
            "annotation": "Write the input of the ELN job per raw file (instructions, base ELN, header, record and context texts).",
            "tool_state": "{\"__page__\": 0, \"stage_cond\": {\"stage\": \"eln\"}}",
            "tool_id": "nexus_llm_input",
            "tool_version": "0.4.0",
            "position": {
                "top": 120,
                "left": 120
            },
            "input_connections": {
                "bundle": [
                    {
                        "id": 6,
                        "output_name": "context_bundles"
                    }
                ],
                "stage_cond|eln": [
                    {
                        "id": 11,
                        "output_name": "eln"
                    }
                ],
                "header": [
                    {
                        "id": 8,
                        "output_name": "header"
                    }
                ],
                "rules": [
                    {
                        "id": 7,
                        "output_name": "rules"
                    }
                ],
                "instructions": [
                    {
                        "id": 7,
                        "output_name": "instructions"
                    }
                ]
            },
            "inputs": [],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {}
        },
        "13": {
            "id": 13,
            "name": "llm_hub",
            "type": "tool",
            "label": "llm",
            "annotation": "Ask the LLM to fill the empty ELN fields; one job per raw file. Skipped unless \"use llm\".",
            "when": "$(inputs.should_run)",
            "tool_state": "{\"__page__\": 0, \"model_condition\": {\"model_type\": \"multimodal\", \"image_context\": null, \"prompt\": \"Follow the instructions in the file eln_instructions.txt exactly. Use only the other context files as sources. Answer with the two YAML blocks only.\"}, \"advanced\": {\"temperature\": 0.0}}",
            "tool_id": "llm_hub",
            "tool_version": "2.53.0+galaxy0",
            "position": {
                "top": 130,
                "left": 130
            },
            "input_connections": {
                "model_condition|text_context": [
                    {
                        "id": 12,
                        "output_name": "llm_context"
                    }
                ],
                "model_condition|model": [
                    {
                        "id": 3,
                        "output_name": "output"
                    }
                ],
                "should_run": [
                    {
                        "id": 2,
                        "output_name": "output"
                    }
                ]
            },
            "inputs": [],
            "outputs": [],
            "workflow_outputs": [
                {
                    "label": "llm answers",
                    "output_name": "output"
                }
            ],
            "post_job_actions": {}
        },
        "14": {
            "id": 14,
            "name": "nexus_eln_llm_merge",
            "type": "tool",
            "label": "merge",
            "annotation": "Keep the LLM values that pass the checks and merge them into the rule ELN.",
            "tool_state": "{\"__page__\": 0}",
            "tool_id": "nexus_eln_llm_merge",
            "tool_version": "0.4.0",
            "position": {
                "top": 140,
                "left": 140
            },
            "input_connections": {
                "bundle": [
                    {
                        "id": 6,
                        "output_name": "context_bundles"
                    }
                ],
                "eln": [
                    {
                        "id": 11,
                        "output_name": "eln"
                    }
                ],
                "answer": [
                    {
                        "id": 13,
                        "output_name": "output"
                    }
                ],
                "header": [
                    {
                        "id": 8,
                        "output_name": "header"
                    }
                ],
                "rules": [
                    {
                        "id": 7,
                        "output_name": "rules"
                    }
                ],
                "instructions": [
                    {
                        "id": 7,
                        "output_name": "instructions"
                    }
                ]
            },
            "inputs": [],
            "outputs": [],
            "workflow_outputs": [
                {
                    "label": "eln files",
                    "output_name": "merged_eln"
                },
                {
                    "label": "eln llm reports",
                    "output_name": "eln_llm_report"
                }
            ],
            "post_job_actions": {}
        },
        "15": {
            "id": 15,
            "name": "pynxtools_spm_converter",
            "type": "tool",
            "label": "convert",
            "annotation": "Convert each raw file and its ELN to NeXus with pynxtools-spm.",
            "tool_state": "{\"__page__\": 0, \"config\": null, \"nxdl\": \"auto\"}",
            "tool_id": "pynxtools_spm_converter",
            "tool_version": "0.5.1+galaxy0",
            "position": {
                "top": 150,
                "left": 150
            },
            "input_connections": {
                "raw_file": [
                    {
                        "id": 6,
                        "output_name": "raw_files"
                    }
                ],
                "eln": [
                    {
                        "id": 14,
                        "output_name": "merged_eln"
                    }
                ]
            },
            "inputs": [],
            "outputs": [],
            "workflow_outputs": [
                {
                    "label": "nexus files",
                    "output_name": "output_nxs"
